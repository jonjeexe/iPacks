<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/about_guide_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/about_guide_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

    <ImageView
        android:id="@+id/dev_photo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="72dp"
        android:src="@drawable/dev_photo"
        android:background="@drawable/circle_mask"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dev_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@jonjeexe"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/dev_photo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dev_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Developer of iPack — a lightweight icon pack built for custom launchers. Made with care, one icon at a time."
        android:textSize="14sp"
        android:textColor="#666666"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/dev_name"
        app:layout_constraintStart_toStartOf="@id/about_guide_left"
        app:layout_constraintEnd_toEndOf="@id/about_guide_right" />

    <TextView
        android:id="@+id/github_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="GitHub"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/dev_description"
        app:layout_constraintStart_toStartOf="@id/about_guide_left" />

    <TextView
        android:id="@+id/dev_github"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_background"
        android:elevation="6dp"
        android:gravity="center"
        android:text="@jonjeexe"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/github_label"
        app:layout_constraintStart_toStartOf="@id/about_guide_left"
        app:layout_constraintEnd_toEndOf="@id/about_guide_right" />

</androidx.constraintlayout.widget.ConstraintLayout>
